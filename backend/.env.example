PORT=3001
AWS_REGION=eu-west-1
JWT_SECRET=change-me-in-production
TABLE_USERS=mindly-users
TABLE_CHECKINS=mindly-checkins
# For local DynamoDB (optional)
DYNAMODB_ENDPOINT=http://localhost:8000
# AWS Bedrock model (use a Claude model enabled in your account and region)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Minimum distinct respondents before any team data is shown to managers/HR
MIN_GROUP_SIZE=5
